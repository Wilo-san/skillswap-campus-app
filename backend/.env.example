# Port de l'API
PORT=4000

# Clé de signature des jetons (mettez une longue chaîne aléatoire)
JWT_SECRET=changez-cette-cle-par-une-chaine-aleatoire-de-40-caracteres

# Base de données : SQLite par défaut (aucune installation)
# DATABASE_URL=sqlite:///./skillswap.db
# PostgreSQL :
# DATABASE_URL=postgresql+psycopg://utilisateur:motdepasse@localhost:5432/skillswap

# Compte administrateur créé au premier démarrage
ADMIN_EMAIL=admin@skillswap.ma
ADMIN_PASSWORD=Admin123!
